# Copiar a .env y completar con valores reales. .env NUNCA se commitea.

# Obligatoria. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar-por-un-valor-random-largo
SQLALCHEMY_DATABASE_URI=sqlite:///umbook.db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-cuenta@gmail.com
# App password de Gmail (no la contraseña de la cuenta). Generarla en
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=cambiar-por-app-password
MAIL_DEFAULT_SENDER=tu-cuenta@gmail.com
# true = no manda correos reales (sirve para probar sin credenciales)
MAIL_SUPPRESS_SEND=false

CORS_ORIGIN=http://localhost:4200
# Dirección del frontend; arma el enlace de registro del correo de invitación
FRONTEND_URL=http://localhost:4200
# 1 = modo debug de Flask (solo para desarrollo, nunca con el servidor expuesto)
FLASK_DEBUG=0
